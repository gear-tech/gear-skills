{
  "name": "gear-dev",
  "description": "Claude Code commands and skills for Gear Protocol development (Vara, ethexe). Bundles Serena (LSP-backed code intelligence) and repomix (on-demand repo flattener) MCP servers.",
  "version": "0.15.0",
  "author": {
    "name": "gear-tech"
  },
  "homepage": "https://github.com/gear-tech/gear-skills",
  "repository": "https://github.com/gear-tech/gear-skills",
  "license": "MIT",
  "keywords": ["gear", "vara", "ethexe", "substrate", "wasm"],
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ]
    },
    "repomix": {
      "command": "npx",
      "args": ["-y", "repomix@latest", "--mcp"]
    }
  }
}
